import { readFileSync, readdirSync } from 'fs'
import { join } from 'path'
import { backtestInstrument, type OhlcvRow } from '../../lib/backtest/core'
const dir = join(process.cwd(), 'scripts', 'backtestData')
let sWarm = 0, sMixed = 0, n = 0
const top: [string, number][] = []
for (const f of readdirSync(dir).filter((x) => x.endsWith('.json')).sort()) {
  const d = JSON.parse(readFileSync(join(dir, f), 'utf8')) as { sector?: string; candles?: OhlcvRow[] }
  const rows = (d.candles ?? []).filter((c) => Number.isFinite(c.close) && c.close > 0)
  if (rows.length < 252) continue
  const r = backtestInstrument(f.replace('.json', ''), d.sector ?? 'Unknown', rows)
  if (!r.bnhCurve) continue
  const aligned = r.bnhCurve[r.bnhCurve.length - 1] / r.bnhCurve[0] - 1
  const noDiv200 = (rows[rows.length - 1].close - rows[200].close) / rows[200].close
  sWarm += r.bnhReturn - aligned
  sMixed += r.bnhReturn - noDiv200
  top.push([f.replace('.json', ''), (r.bnhReturn - aligned) * 100])
  n++
}
top.sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]))
console.log('WARMUP-ONLY delta (bnhReturn[bar0] - bnhCurve[bar200], both dividend-reinvested):')
console.log('  mean over', n, '=', ((sWarm / n) * 100).toFixed(2), 'pp')
console.log('  (previously reported, dividend-contaminated:', ((sMixed / n) * 100).toFixed(2), 'pp)')
console.log('  largest 6:', top.slice(0, 6).map(([t, v]) => `${t} ${v.toFixed(2)}pp`).join(', '))
console.log('  sign: positive count =', top.filter(([, v]) => v > 0).length, '/', n)
