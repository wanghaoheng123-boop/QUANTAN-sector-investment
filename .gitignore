.pytest_cache/

# ─── SQLite databases (do NOT commit) ────────────────────────────────────────
*.db
*.db-journal

# ─── Claude / Cursor agent artifacts ─────────────────────────────────────────
# `.claude/agents/` and `.claude/commands/` ARE committed: they are shared,
# reviewable config that every future session boots from, not artifacts. The
# rest of `.claude/` stays ignored — `worktrees/` holds entire checked-out
# trees, `settings.local.json` and `launch.json` are per-machine.
#
# The pattern must be `.claude/*`, NOT `.claude/`: git cannot re-include a path
# whose parent directory is excluded, so a trailing-slash ignore would silently
# swallow the negations below and the agent roster would never reach a commit.
.claude/*
!.claude/agents/
!.claude/commands/
.cursor/

# ─── Phase 14 wave 30: parallel-worktree leak directory ──────────────────────
# CI agents running side-by-side can leave a `.clone/worktrees/<branch>/`
# directory in the active worktree. Ignored to prevent re-tracking.
.clone/

# Stryker (mutation testing) outputs
/reports/mutation/
/.stryker-tmp/
multi_agent_factor_mining/factor_library.json
